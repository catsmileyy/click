{
  "name": "dungeon-clicker",
  "version": "2.0.0",
  "description": "Dungeon Clicker · Technovas: NestJS homework starter",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
